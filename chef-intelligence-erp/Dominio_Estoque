} from "../models/ItemEstoque"; // Importação real
import EstoqueRegistroMovimento, {
  EstoqueRegistroMovimentoCreationAttributes,
} from "../models/EstoqueRegistroMovimento"; // Importação real

// 💡 CORREÇÃO FINAL (TS2305): Removemos o import type.
// Usamos apenas a importação do VALOR (o construtor) e o renomeamos.
import DecimalCtor from "decimal.js";

// Tipagem para Entrada (Recebimento) de Estoque
interface EntradaEstoqueData {
  id_produto: number;
  quantidade: number;
  custo_unitario: number;
  colaborador_id: number;
  tipo_movimento: "COMPRA" | "AJUSTE_ENTRADA";
  referencia_origem: string;
}

// Tipagem para Saída (Baixa) de Estoque
interface SaidaEstoqueData {
  id_produto: number;
  quantidade: number;
  colaborador_id: number;
  tipo_movimento: "VENDA" | "PRODUCAO" | "PERDA" | "AJUSTE_SAIDA";
  referencia_origem: string;
}

interface SaidaEstoqueResultado {
  produto: ItemEstoqueModel;
  custo_saida: number; // O CMV (Custo da Mercadoria Vendida) ou custo da saída
}

// 🔑 Tipo de instância: Obter o tipo da instância do construtor DecimalCtor
type DecimalInstance = InstanceType<typeof DecimalCtor>;

export class EstoqueItemService {
  private sequelize: Sequelize;

  constructor(sequelize: Sequelize) {
    this.sequelize = sequelize;
  } // ---------------------------------------------------- // --- MÉTODOS CRUD BÁSICOS --- // ----------------------------------------------------

  public async create(
    data: ItemEstoqueCreationAttributes
  ): Promise<ItemEstoqueModel> {
    const transaction = await this.sequelize.transaction();
    try {
      const item = await ItemEstoque.create(data, { transaction });
      await transaction.commit();
      return item;
    } catch (error) {
      await transaction.rollback();
      throw error;
    }
  }

  public async findAll(): Promise<ItemEstoqueModel[]> {
    return ItemEstoque.findAll();
  }

  public async findById(id_produto: number): Promise<ItemEstoqueModel | null> {
    return ItemEstoque.findByPk(id_produto);
  }

  public async update(
    id_produto: number,
    updates: Partial<ItemEstoqueAttributes>
  ): Promise<ItemEstoqueModel> {
    const produto = await this.findById(id_produto);
    if (!produto) {
      throw new Error("Item de estoque não encontrado.");
    }
    await produto.update(updates);
    return produto;
  }  // ---------------------------------------------------- // --- LÓGICA DE MOVIMENTAÇÃO DE ESTOQUE (R2, R3) --- // ----------------------------------------------------
  /**
   * Registra a entrada de estoque e atualiza o CMP (Custo Médio Ponderado - R3).
   */

  public async receberEstoque(
    data: EntradaEstoqueData,
    externalTransaction?: Transaction
  ): Promise<ItemEstoqueModel> {
    const {
      id_produto,
      quantidade,
      custo_unitario,
      colaborador_id,
      tipo_movimento,
      referencia_origem,
    } = data; // 🔑 INÍCIO DA TRANSAÇÃO ATÔMICA

    const transaction =
      externalTransaction || (await this.sequelize.transaction());

    try {
      // 1. Buscar e bloquear o Item de Estoque (LOCK.UPDATE)
      const produto = (await ItemEstoque.findByPk(id_produto, {
        lock: transaction.LOCK.UPDATE,
        transaction,
      })) as ItemEstoqueModel | null;

      if (!produto) {
        throw new Error(`Produto ID ${id_produto} não encontrado.`);
      } // Usando DecimalCtor para cálculos precisos (R3)

      const qteNova = new DecimalCtor(quantidade);
      const custoNovoUnitario = new DecimalCtor(custo_unitario);
      const estoqueAnterior = new DecimalCtor(produto.estoque_atual);
      const cmpAnterior = new DecimalCtor(produto.preco_custo_unitario); // CMP = [(Estoque Antigo * CMP Antigo) + (Qte Nova * Custo Novo)] / (Estoque Antigo + Qte Nova)

      const custoTotalAntigo = estoqueAnterior.times(cmpAnterior);
      const custoTotalNovo = qteNova.times(custoNovoUnitario);
      const novoEstoqueTotal = estoqueAnterior.plus(qteNova);

      let novoCmp: DecimalInstance; // ⬅️ MUDANÇA AQUI: Usa o novo tipo derivado
      if (novoEstoqueTotal.isZero()) {
        novoCmp = new DecimalCtor(0);
      } else {
        novoCmp = custoTotalAntigo
          .plus(custoTotalNovo)
          .dividedBy(novoEstoqueTotal);
      }
      const custoTotalMovimento = custoTotalNovo; // 2. Registro do Movimento (Auditoria)

      const movimentoData: EstoqueRegistroMovimentoCreationAttributes = {
        id_produto,
        tipo_movimento: "ENTRADA",
        quantidade: qteNova.toNumber(),
        preco_custo_unitario_momento: novoCmp.toNumber(),
        custo_total_movimento: custoTotalMovimento.toNumber(),
        estoque_anterior: estoqueAnterior.toNumber(),
        estoque_atual: novoEstoqueTotal.toNumber(),
        referencia_origem,
        colaborador_id,
        observacoes: `${tipo_movimento}: ${referencia_origem}`,
      };
      await EstoqueRegistroMovimento.create(movimentoData, { transaction }); // 3. Atualização do Item de Estoque

      await produto.update(
        {
          estoque_atual: novoEstoqueTotal.toNumber(),
          preco_custo_unitario: novoCmp.toNumber(), // O novo CMP
        },
        { transaction }
      ); // 4. Commit (apenas se a transação for interna)

      if (!externalTransaction) {
        await transaction.commit();
      }

      return produto;
    } catch (error) {
      if (!externalTransaction) {
        await transaction.rollback();
      }
      throw error;
    }
  }
  /**
   * Registra a saída de estoque (baixa) e retorna o CMV (R2, R3).
   */

  public async saidaEstoque(
    data: SaidaEstoqueData,
    externalTransaction?: Transaction
  ): Promise<SaidaEstoqueResultado> {
    const {
      id_produto,
      quantidade,
      colaborador_id,
      tipo_movimento,
      referencia_origem,
    } = data; // 🔑 INÍCIO DA TRANSAÇÃO ATÔMICA

    const transaction =
      externalTransaction || (await this.sequelize.transaction());

    try {
      // 1. Buscar e bloquear o Item de Estoque (LOCK.UPDATE)
      const produto = (await ItemEstoque.findByPk(id_produto, {
        lock: transaction.LOCK.UPDATE,
        transaction,
      })) as ItemEstoqueModel | null;

      if (!produto) {
        throw new Error(`Produto ID ${id_produto} não encontrado.`);
      } // Usando DecimalCtor para cálculos precisos (R3)

      const qteBaixa = new DecimalCtor(quantidade);
      const estoqueAnterior = new DecimalCtor(produto.estoque_atual);
      const cmpAtual = new DecimalCtor(produto.preco_custo_unitario); // 2. Validação R2: Saldo não Negativo (Bloqueio Negativo)

      const novoEstoque = estoqueAnterior.minus(qteBaixa);

      if (novoEstoque.isNegative()) {
        throw new Error(
          `R2: Saldo insuficiente. Estoque disponível: ${estoqueAnterior.toFixed(
            3
          )} ${produto.unidade_medida}. Necessário: ${qteBaixa.toFixed(3)}.`
        );
      } // 3. Custo da Saída (CMV - R3)

      const custoSaida = qteBaixa.times(cmpAtual); // 4. Registro do Movimento (Auditoria)

      const movimentoData: EstoqueRegistroMovimentoCreationAttributes = {
        id_produto,
        tipo_movimento: "SAIDA",
        quantidade: qteBaixa.toNumber(),
        preco_custo_unitario_momento: cmpAtual.toNumber(),
        custo_total_movimento: custoSaida.toNumber(),
        estoque_anterior: estoqueAnterior.toNumber(),
        estoque_atual: novoEstoque.toNumber(),
        referencia_origem,
        colaborador_id,
        observacoes: `${tipo_movimento}: ${referencia_origem}`,
      };
      await EstoqueRegistroMovimento.create(movimentoData, { transaction }); // 5. Atualização do Item de Estoque

      await produto.update(
        {
          estoque_atual: novoEstoque.toNumber(),
        },
        { transaction }
      ); // 6. Commit (apenas se a transação for interna)

      if (!externalTransaction) {
        await transaction.commit();
      }

      return {
        produto,
        custo_saida: custoSaida.toNumber(),
      };
    } catch (error) {
      if (!externalTransaction) {
        await transaction.rollback();
      }
      throw error;
    }
  }  // ---------------------------------------------------- // --- MÉTODO ORQUESTRADOR PARA VENDAS/PRODUÇÃO (R5) --- // ----------------------------------------------------
  /**
   * Método orquestrador que realiza a baixa de múltiplos itens (Venda/Produção)
   * e retorna o CMV total da operação, usando a transação fornecida.
   * Este método é o ponto de integração para VendaComandaService.
   *
   * @param itensParaBaixa Lista de { id_produto, quantidade_vendida }
   * @param colaborador_id ID do colaborador responsável.
   * @param referencia_origem Ex: "VENDA_COMANDA_123"
   * @param transaction Transação externa obrigatória (R5).
   * @returns O CMV (Custo da Mercadoria Vendida) total da operação.
   */

  public async darBaixaVenda(
    itensParaBaixa: {
      id_produto: number;
      quantidade_vendida: number;
    }[],
    colaborador_id: number,
    referencia_origem: string,
    transaction: Transaction // Exige transação externa (R5)
  ): Promise<number> {
    // Usando DecimalCtor para acumular o custo total (CMV)
    let cmvTotal = new DecimalCtor(0); // Processar cada item na mesma transação

    for (const item of itensParaBaixa) {
      const saidaData: SaidaEstoqueData = {
        id_produto: item.id_produto,
        quantidade: item.quantidade_vendida,
        colaborador_id,
        tipo_movimento: "VENDA",
        referencia_origem,
      }; // Reutiliza a lógica de saidaEstoque, passando a transação externa

      const resultado = await this.saidaEstoque(saidaData, transaction);
      cmvTotal = cmvTotal.plus(resultado.custo_saida);
    }

    return cmvTotal.toNumber();
  }
}



