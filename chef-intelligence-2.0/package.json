{
  "name": "chef-intelligence-2.0",
  "version": "1.0.0",
  "description": "Plataforma de Melhoria Contínua Chef Intelligence ERP.",
  "main": "Backend/dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build:backend": "tsc -p Backend/tsconfig.json",
    "build:frontend": "next build frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "node Backend/dist/index.js",
    "dev:backend": "ts-node-dev --respawn --transpile-only --project Backend/tsconfig.json Backend/src/index.ts",
    
    
    "dev:frontend": "next dev frontend -p 3001",
    
    
    "dev": "npm run dev:backend & npm run dev:frontend", 
    
    "test": "jest --detectOpenHandles",
    "type-check": "tsc --noEmit -p Backend/tsconfig.json",
    "lint": "eslint Backend/src --ext .ts",
    "format": "prettier --write \"Backend/src/**/*.ts\""
  },
  "keywords": [
    "ERP",
    "TypeScript",
    "Sequelize",
    "Food Service"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@reduxjs/toolkit": "^2.0.1",
    "@tanstack/react-table": "^8.10.7",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.554.0",
    "next": "^14.0.3",
    "next-auth": "^4.24.5",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "recharts": "^2.10.3",
    "sequelize": "^6.37.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/decimal.js": "^0.0.32",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "@types/react-redux": "^7.1.33",
    "@types/sequelize": "^4.28.20",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.4.32",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.3.6",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}