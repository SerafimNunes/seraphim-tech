{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend Services for Chef Intelligence ERP",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node --project tsconfig.json src/index.ts\"",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest --detectOpenHandles",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "check:associations": "ts-node --project tsconfig.json src/scripts/checkAssociations.ts"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@types/cors": "^2.8.19",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/decimal.js": "^0.0.32",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/sequelize": "^4.28.20",
    "eslint": "link:/eslint",
    "eslint-config-prettier": "link:/eslint-config-prettier",
    "eslint-plugin": "link:/@typescript-eslint/eslint-plugin",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "parser": "link:/@typescript-eslint/parser",
    "ts-jest": "^29.1.4",
    "ts-node": "^11.0.0-beta.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
